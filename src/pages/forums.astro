---
import BaseLayout from '../layouts/BaseLayout.astro'
import { ForumsPage } from '../views/ForumsPage'
import { BLOGS } from '../data/blogs'
import { SEO, SITE_URL } from '../data/site'
import { parseBoardCategoryId, threadViewCount } from '../lib/forum-board'

const category = parseBoardCategoryId(Astro.url.searchParams.get('category'))
const query = Astro.url.searchParams.get('q') ?? ''

const threads = BLOGS.map((post) => ({
  slug: post.slug,
  title: post.title,
  excerpt: post.excerpt,
  tag: post.tag,
  date: post.date,
  replies: post.replies.length,
  views: threadViewCount(post.slug),
}))

const jsonLdExtra = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: `${SITE_URL}/forums` },
    ],
  },
]
---

<BaseLayout seo={SEO.forums} jsonLdExtra={jsonLdExtra}>
  <ForumsPage threads={threads} category={category} query={query} />
</BaseLayout>
