---
import BaseLayout from '../layouts/BaseLayout.astro'
import { GameProductPage } from '../views/GameProductPage'
import { GAME_SLUG, PRODUCT_PATH, SEO, SITE_NAME, SITE_URL } from '../data/site'
import { productDetailJsonLd } from '../lib/seo'
import { getGame } from '../data/games'

const game = getGame(GAME_SLUG)
const jsonLdExtra = [
  productDetailJsonLd(game?.status ?? 'Updating'),
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
      {
        '@type': 'ListItem',
        position: 2,
        name: SITE_NAME,
        item: `${SITE_URL}${PRODUCT_PATH}`,
      },
    ],
  },
]
---

<BaseLayout seo={SEO.product} jsonLdExtra={jsonLdExtra}>
  <GameProductPage guideSlug="wardogs-cheats" />
</BaseLayout>
