---
import '../styles/global.css'
import {
  BRAND_APPLE_TOUCH_ICON,
  BRAND_FAVICON,
  BRAND_FAVICON_16,
  OG_IMAGE,
  SITE_NAME,
  absoluteUrl,
  type PageSeo,
} from '../data/site'
import { WARDOGS_COVER_CARD, getForumMedia } from '../data/media'
import { buildPageJsonLd } from '../lib/seo'

type Props = {
  seo: PageSeo
  jsonLdExtra?: unknown[]
  bodyClass?: string
}

const { seo, jsonLdExtra = [], bodyClass = 'bg-z-bg text-z-ink' } = Astro.props
const url = absoluteUrl(seo.path)
const image = seo.image || OG_IMAGE
const imageUrl = image.startsWith('http') ? image : absoluteUrl(image)
const imageAlt = seo.imageAlt || seo.title
/** Google SERP thumbnails prefer crawlable JPEG 1200x630 */
const isOgJpeg = image.includes('/og/') && image.endsWith('.jpg')
const imageType = isOgJpeg
  ? 'image/jpeg'
  : image.endsWith('.webp')
    ? 'image/webp'
    : image.endsWith('.gif')
      ? 'image/gif'
      : 'image/jpeg'
const isGalleryWebp = image.includes('/media/image-')
const imageWidth = isOgJpeg ? 1200 : isGalleryWebp ? 480 : 1200
const imageHeight = isOgJpeg ? 630 : isGalleryWebp ? (image.includes('image-2') ? 290 : 270) : 630
const robots =
  seo.robots ||
  'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'
const jsonLd = buildPageJsonLd(seo, jsonLdExtra)
const forumSlug = seo.path.match(/^\/forums\/([^/]+)$/)?.[1]
const forumStill = forumSlug ? getForumMedia(forumSlug).image : ''
const preloadLcp =
  seo.path === '/wardogs-cheats'
    ? { href: WARDOGS_COVER_CARD, type: 'image/webp' }
    : forumStill
      ? {
          href: forumStill,
          type: forumStill.endsWith('.webp') ? 'image/webp' : 'image/jpeg',
        }
      : null
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#08060f" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.ico?v=6" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="16x16" href={BRAND_FAVICON_16} />
    <link rel="icon" type="image/png" sizes="32x32" href={BRAND_FAVICON} />
    <link rel="shortcut icon" type="image/png" sizes="32x32" href={BRAND_FAVICON} />
    <link rel="apple-touch-icon" sizes="180x180" href={BRAND_APPLE_TOUCH_ICON} />

    {preloadLcp ? (
      <link rel="preload" as="image" href={preloadLcp.href} type={preloadLcp.type} fetchpriority="high" />
    ) : null}

    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <meta name="robots" content={robots} />
    <meta name="googlebot" content={robots} />
    <meta name="bingbot" content={robots} />
    <meta name="author" content={SITE_NAME} />
    <link rel="canonical" href={url} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    {/* Self-referential hreflang (en + x-default) — required by Seobility / Google */}
    <link rel="alternate" href={url} hreflang="en" />
    <link rel="alternate" href={url} hreflang="x-default" />
    {/* Legacy crawlers still read image_src for result thumbnails */}
    <link rel="image_src" href={imageUrl} />

    <meta property="og:type" content={seo.ogType || 'website'} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:url" content={imageUrl} />
    <meta property="og:image:secure_url" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:type" content={imageType} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class={bodyClass}>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-z-accent focus:px-4 focus:py-2 focus:text-white"
    >
      Skip to content
    </a>
    <div id="main">
      <slot />
    </div>
    <script is:inline>
      (function () {
        var v = document.getElementById('hero-bg-video')
        if (!v) return
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return
        function show() {
          v.style.opacity = '1'
        }
        v.addEventListener('playing', show, { once: true })
        v.addEventListener('loadeddata', show, { once: true })
        if (v.readyState >= 2) show()
        var p = v.play()
        if (p && p.catch) p.catch(function () {})
      })()
    </script>
  </body>
</html>
